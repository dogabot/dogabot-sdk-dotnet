<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Dogabot.Sdk</RootNamespace>
    <AssemblyName>Dogabot.Sdk</AssemblyName>
    <PackageId>Dogabot.Sdk</PackageId>
    <Version>0.1.1</Version>
    <Authors>dogabot</Authors>
    <Description>Official dogabot REST API SDK for .NET</Description>
    <PackageProjectUrl>https://docs.dogabot.com/sdk/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dogabot/dogabot-sdk-dotnet</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>dogabot;trading;sdk;api</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Public sync puts README.md at repo root; pack it into the nupkg. -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
